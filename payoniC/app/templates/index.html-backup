<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payonic | Secure University Transactions</title>
    <link rel="stylesheet" href="css/style.css">
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>
    <div id="app">
        <!-- Navigation will be injected here -->
        <nav class="navbar" id="navbar">
            <div class="container nav-content">
                <a href="#" class="nav-brand" id="brand-link">
                    <i data-lucide="zap" class="text-gradient"></i>
                    Payonic
                </a>
                <ul class="nav-links" id="nav-links">
                    <!-- Links injected based on auth state -->
                </ul>
            </div>
        </nav>

        <main class="container" id="main-content">
            <!-- Dynamic content will be injected here -->
            <div class="centered-layout">
                <div class="glass-panel auth-card animate-fade-in">
                    <h2 class="text-gradient">Welcome back</h2>
                    <p class="hero-subtitle">Loading Payonic...</p>
                </div>
            </div>
        </main>

        <div id="flash-messages" class="flash-messages"></div>
    </div>

    <!-- Application Scripts -->
    <script src="js/store.js"></script>
    <script src="js/components.js"></script>
    <script src="js/app.js"></script>
</body>

</html>